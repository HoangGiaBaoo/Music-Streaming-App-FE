    <!-- ============================================================ -->
    <!-- Spotify palette (chuẩn theo brand guideline)                  -->
    <!-- ============================================================ -->

    <!-- Nền chính -->
    <color name="spotify_black">#121212</color>       <!-- nền toàn app -->
    <color name="spotify_dark">#191414</color>        <!-- nền thẻ, bottom bar -->
    <color name="spotify_surface">#282828</color>     <!-- card, item list -->
    <color name="spotify_elevated">#3E3E3E</color>    <!-- hover state, divider -->

    <!-- Màu nhấn -->
    <color name="spotify_green">#1DB954</color>       <!-- nút play, active tab, progress bar -->
    <color name="spotify_green_dark">#1AA34A</color>  <!-- pressed state của nút green -->

    <!-- Text -->
    <color name="spotify_white">#FFFFFF</color>       <!-- text chính -->
    <color name="spotify_gray">#B3B3B3</color>        <!-- text phụ, subtitle -->
    <color name="spotify_gray_dark">#535353</color>   <!-- text mờ, placeholder -->

    <!-- ============================================================ -->
    <!-- Alias giữ backward-compat cho layout cũ                       -->
    <!-- (đừng xoá — toàn bộ XML hiện tại đang tham chiếu các tên này) -->
    <!-- ============================================================ -->
    <color name="bg_primary">#121212</color>          <!-- = spotify_black -->
    <color name="bg_secondary">#191414</color>        <!-- = spotify_dark -->
    <color name="bg_elevated">#282828</color>         <!-- = spotify_surface -->
    <color name="accent_white">#FFFFFF</color>        <!-- = spotify_white -->
    <color name="text_secondary">#B3B3B3</color>      <!-- = spotify_gray -->
    <color name="text_disabled">#535353</color>       <!-- = spotify_gray_dark -->
    <color name="progress_bg">#535353</color>         <!-- = spotify_gray_dark -->
    <color name="surface_dark">#191414</color>        <!-- = spotify_dark -->
    <color name="divider">#3E3E3E</color>             <!-- = spotify_elevated -->
    <color name="outline_grey">#535353</color>        <!-- = spotify_gray_dark -->

