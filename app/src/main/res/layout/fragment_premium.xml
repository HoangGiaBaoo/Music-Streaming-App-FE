<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Hero collage placeholder -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_card_pink"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_premium"
                android:tint="@color/spotify_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/premium_label"
                android:textColor="@color/accent_white"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:text="@string/premium_headline"
            android:textColor="@color/accent_white"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <!-- Banner gói hiện tại (hiện khi user đã Premium) -->
        <LinearLayout
            android:id="@+id/layout_current_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_reasons_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_current_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/spotify_green"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_current_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_premium_start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_white_pill"
            android:text="@string/premium_start"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Reasons card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_reasons_card"
            android:orientation="vertical"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="6dp"
                android:text="@string/premium_reasons"
                android:textColor="@color/accent_white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_no_ads"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_download"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_shuffle"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_quality"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_friends"/>

            <include layout="@layout/item_premium_reason"
                android:id="@+id/reason_queue"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
