<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top bar with disabled premium banner mini -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/accent_white"
                android:visibility="gone"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:alpha="0.5"
                android:text="Trải nghiệm âm nhạc đỉnh cao với Pr…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:text="@string/premium_plans_title"
            android:textColor="@color/accent_white"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- Individual card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_premium_individual">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_pink"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/plan_offer"
                android:textColor="@color/bg_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_premium"
                    android:tint="@color/accent_white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Premium"
                    android:textColor="@color/accent_white"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Individual"
                android:textColor="#F8C8DC"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="•  1 tài khoản Premium"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Hủy bất cứ lúc nào"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Đăng ký hoặc thanh toán một lần"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btn_subscribe_individual"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_pill_pink"
                android:text="@string/premium_start"
                android:textAllCaps="false"
                android:textColor="@color/bg_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Student card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_premium_student">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/plan_offer"
                android:textColor="@color/bg_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_premium"
                    android:tint="@color/accent_white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Premium"
                    android:textColor="@color/accent_white"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Student"
                android:textColor="#D4BBFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="•  1 tài khoản Premium đã xác minh"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Giảm giá cho sinh viên đủ điều kiện"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Hủy bất cứ lúc nào"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Đăng ký hoặc thanh toán một lần"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btn_subscribe_student"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_pill_purple"
                android:text="@string/premium_start"
                android:textAllCaps="false"
                android:textColor="@color/bg_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Family card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_premium_family">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/plan_offer"
                android:textColor="@color/bg_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_premium"
                    android:tint="@color/accent_white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Premium"
                    android:textColor="@color/accent_white"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Family"
                android:textColor="#C8E6A0"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="•  Tối đa 6 tài khoản Premium"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Quản lý hồ sơ Family Mix"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="•  Hủy bất cứ lúc nào"
                android:textColor="@color/accent_white"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btn_subscribe_family"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_pill_green"
                android:text="@string/premium_start"
                android:textAllCaps="false"
                android:textColor="@color/bg_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
