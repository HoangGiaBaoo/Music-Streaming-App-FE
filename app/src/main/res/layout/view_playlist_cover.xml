<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- Single mode: full-bleed ImageView shown when coverUrl set or 1-3 tracks -->
    <ImageView
        android:id="@+id/cover_single"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_gradient"/>

    <!-- Grid mode: 2x2 GridLayout shown when >=4 tracks and no custom coverUrl -->
    <GridLayout
        android:id="@+id/cover_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="2"
        android:rowCount="2"
        android:visibility="gone">

        <ImageView
            android:id="@+id/cover_q0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_gradient"/>

        <ImageView
            android:id="@+id/cover_q1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_gradient"/>

        <ImageView
            android:id="@+id/cover_q2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_gradient"/>

        <ImageView
            android:id="@+id/cover_q3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_gradient"/>
    </GridLayout>
</merge>
