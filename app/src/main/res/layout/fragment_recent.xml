<?xml version="1.0" encoding="utf-8"?>
<!-- Bản Fragment của màn "Đã nghe gần đây": KHÔNG có bottom-nav/mini-player riêng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        android:title="@string/drawer_recent"
        android:titleTextColor="@color/accent_white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/accent_white"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                style="@style/RecentChip"
                android:text="@string/recent_filter_music"/>
            <TextView
                style="@style/RecentChip"
                android:text="@string/recent_filter_playlists"/>
            <TextView
                style="@style/RecentChip"
                android:text="@string/recent_filter_albums"/>
            <TextView
                style="@style/RecentChip"
                android:text="@string/recent_filter_podcasts"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="32dp"
        android:clipToPadding="false"/>
</LinearLayout>
